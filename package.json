{
  "name": "@haksanlulz/mcp-wagewatch",
  "version": "1.1.0",
  "description": "MCP server over the U.S. DOL Wage and Hour Division enforcement dataset (employer wage-theft history and back wages owed) for nonprofits, legal aid, and worker-justice organizers.",
  "type": "module",
  "license": "MIT",
  "author": "Abishai James",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haksanlulz/mcp-wagewatch.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build && npm run typecheck && npm test",
    "smoke": "tsx smoke.ts",
    "start": "tsx index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.check.json",
    "verify:pack": "node scripts/pack-probe.mjs",
    "pack:mcpb": "node scripts/pack-mcpb.mjs",
    "verify:mcpb": "node scripts/mcpb-probe.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "dol",
    "wage-and-hour",
    "whisard",
    "wage-theft",
    "back-wages",
    "labor",
    "enforcement",
    "civic-data"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "main": "dist/index.js",
  "bin": {
    "mcp-wagewatch": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
